{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:parity": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-parity.mts",
    "check:errors": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-errors.mts",
    "check:whatif": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/check-whatif-e2e.mts",
    "test:e2e": "node scripts/check-e2e-ports.mjs && playwright test",
    "check": "npm run lint && npm run check:contrast && npm run check:parity && npm run check:errors"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
