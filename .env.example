# DiaInsights environment.
#
# Copy to `.env` and adjust. `docker compose` reads this file automatically.
# Never commit a real .env.
#
# This file is for LOCAL DEVELOPMENT (plain `docker compose up`, which auto-loads
# docker-compose.override.yml). For production set DOMAIN in your shell instead:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ---------------------------------------------------------------- frontend
# Baked into the client bundle at BUILD time: changing it requires a rebuild
# (`docker compose up --build`), not just a restart.
#
# This URL is resolved by the BROWSER, so it must be publicly reachable. Inside a
# compose network the service name `backend` resolves for containers only -- using it
# here makes the app build fine and then fail in the user's browser.
#
# Production overrides this in docker-compose.prod.yml to https://$DOMAIN/api.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------ backend
# Comma-separated list of browser origins allowed to call the API. Must match
# wherever the frontend is served from.
ALLOWED_ORIGINS=http://localhost:3000

# Requests per client IP per minute. /health is exempt. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=60

# Set to 1 ONLY when a reverse proxy you control sits in front of the API.
#
# Behind a proxy every client shares the proxy's address, so the limiter would treat
# every visitor as one person and cap the whole site at RATE_LIMIT_PER_MINUTE. Turning
# this on makes the API read X-Forwarded-For -- counted from the RIGHT, so a forged
# header cannot be used to mint extra buckets.
#
# Only enable it if the proxy OVERWRITES the header. If it merely appends to a
# client-supplied one, leave this off.
TRUST_PROXY_HEADERS=0

# How many proxies sit in front of the API. 1 = a single reverse proxy such as Caddy.
FORWARDED_TRUSTED_HOPS=1